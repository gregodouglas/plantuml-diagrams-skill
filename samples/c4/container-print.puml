@startuml
!include <C4/C4_Container>
' ---- house style (print) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 160
skinparam wrapWidth 160
<style>
root {
  FontName Helvetica
  FontSize 12
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1; FontSize 11; MaximumWidth 160 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 11; MaximumWidth 200 }
title   { FontSize 15; FontStyle bold }
caption { FontSize 11; FontColor #64748B }
legend  { FontSize 11; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 80
skinparam ranksep 40
LAYOUT_TOP_DOWN()

' ---- body ----
title Venue Ticketing: containers
' C4-PlantUML from the bundled stdlib (offline). Layout helpers: LAYOUT_TOP_DOWN(), LAYOUT_LEFT_RIGHT(),
' LAYOUT_LANDSCAPE(), Lay_D/U/L/R(a, b). SHOW_LEGEND() must be the last line.

AddElementTag("accent", $bgColor="#1D4ED8", $fontColor="#FFFFFF", $borderColor="#1E3A8A", $legendText="Container in focus")

Person(fan, "Fan", "")
Person(staff, "Venue staff", "")

Container(fanapp, "Fan web app", "TypeScript SPA, CDN", "Browse, seat picker, checkout")
Container(staffapp, "Staff app", "TypeScript PWA", "Event setup, box office, door scanning")
Container(api, "Ticketing API", "Python, FastAPI", "All business logic", $tags="accent")
ContainerDb(db, "Database", "PostgreSQL 16", "System of record")
ContainerDb(cache, "Seat-hold cache", "Redis", "10-minute seat holds")
ContainerQueue(queue, "Job queue", "SQS", "With a dead-letter queue")
Container(worker, "Worker", "Python", "PDFs, email, webhooks, hold expiry")
ContainerDb(store, "Ticket store", "S3 bucket", "Rendered ticket PDFs")

System_Ext(idp, "Identity provider", "OIDC")
System_Ext(pay, "Payment provider", "Card payments")
System_Ext(email, "Email service", "Transactional email")

Rel(fan, fanapp, "Uses")
Rel(staff, staffapp, "Uses")
Rel(fanapp, api, "Calls", "JSON/HTTPS")
Rel(staffapp, api, "Calls", "JSON/HTTPS")
Rel(fanapp, idp, "Signs in", "OIDC, PKCE")
Rel(staffapp, idp, " ", "OIDC, PKCE")
Rel(api, idp, "Validates tokens", "JWKS")
Rel(api, db, "Reads/writes", "SQL")
Rel(api, cache, "Holds seats")
Rel(api, pay, "Authorizes, refunds")
Rel(pay, api, "Sends webhooks")
Rel(api, queue, "Enqueues jobs")
Rel_U(worker, queue, "Consumes jobs")
Rel(worker, db, "Reads/writes", "SQL")
Rel(worker, store, "Writes PDFs")
Rel(worker, email, "Sends email")


SHOW_LEGEND()
@enduml
