@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
  LineColor #475569
  LineThickness 1.2
}
element { BackgroundColor #F1F5F9; LineColor #475569; RoundCorner 6 }

arrow   { LineColor #475569; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
document { title { FontSize 18; FontStyle bold; LineThickness 0 } }
actor   { LineThickness 1.2 }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

title Network boundary (medium)

actor "Remote users" as remote
cloud "Internet" as inet

rectangle "Edge firewall pair\nHA active / standby" as fwpair #EFF6FF {
  node "FW-A\nactive" as fwa <<accent>>
  node "FW-B\nstandby" as fwb
}

rectangle "DMZ  172.16.10.0/24" as dmz #FFF7ED {
  node "WAF /\nreverse proxy" as waf
  node "Public web" as web
  node "Mail relay" as mail
  node "VPN\nconcentrator" as vpn
}

rectangle "Servers  10.10.10.0/24" as srv #F0FDF4 {
  node "AD DS\ndomain controller" as dc
  node "App server" as app
}
rectangle "Users  10.10.20.0/24" as usr #F0FDF4 {
  node "Workstations" as ws
}
rectangle "Management  10.10.99.0/24" as mgmt #F5F3FF {
  node "Jump host" as jump
  node "SIEM /\nlog collector" as siem
}
cloud "Microsoft cloud" as msft {
  node "Entra ID" as entra
  node "Microsoft 365" as m365
}

remote --> inet  : SSL VPN 443
inet   --> fwpair : ISP A 1 Gb
inet   --> fwpair : ISP B backup
fwa     -  fwb
fwpair --> waf   : HTTPS 443
waf    --> web   : HTTP 8080
fwpair --> mail  : SMTP 25
fwpair --> vpn   : TLS 443
vpn    --> usr   : RDP via policy
fwpair <-- ws    : NAT out 443
ws     --> dc    : LDAP, Kerberos
ws     --> app   : HTTPS 443
jump   --> fwpair : SSH 22 mgmt
fwpair --> siem  : syslog 514
dc     --> entra : Entra Connect
fwpair --> msft  : IPsec S2S

legend right
  |= Fill |= Trust zone |
  |<#FFF7ED>   | DMZ: internet-facing |
  |<#F0FDF4>   | Internal: trusted |
  |<#F5F3FF>   | Management: restricted |
  |<#1D4ED8>   | active enforcement point |
endlegend
@enduml
