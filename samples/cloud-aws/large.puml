@startuml
' ---- house style (print) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 160
skinparam wrapWidth 160
<style>
root {
  FontName Helvetica
  FontSize 12
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1; FontSize 11; MaximumWidth 160 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 11; MaximumWidth 200 }
title   { FontSize 15; FontStyle bold }
caption { FontSize 11; FontColor #64748B }
legend  { FontSize 11; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
top to bottom direction

' ---- body ----
title Venue Ticketing on AWS: overview (production)

actor "Fans and staff" as users
[Route 53\nthree public names] as r53
[CloudFront + WAF\n+ ACM] as cf
database "S3 static assets\nfan and staff apps" as s3s

rectangle "VPC, 2 AZs" as vpc {
  [ALB + NAT gateways\npublic subnets] as pub
  [ECS Fargate\napi, worker] as ecs
  database "RDS PostgreSQL\nElastiCache Redis" as data
}
queue "SQS jobs\n+ jobs-dlq" as sqs
database "S3 tickets" as s3t
[Amazon SES] as ses
[CloudWatch + SNS\nalarms page on-call] as ops
[Identity and Payment\nproviders] as ext <<muted>>

users --> r53 : resolve
users --> cf : HTTPS
cf --> s3s : static
cf --> vpc : API
pub --> ecs : route
ecs --> data : SQL, holds
ecs ---> sqs : jobs
ecs ---> s3t : PDFs
ecs ---> ses : email
ecs ---> ops : logs
pub --> ext : via NAT

legend bottom right
  Detail diagrams: large-edge, large-network, large-compute-data, large-ops.
  Grey: outside AWS.
endlegend
@enduml
