@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
stateDiagram {
  state { BackgroundColor #F8FAFC }
}
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60

' ---- body ----
title How the four state machines interact
hide empty description

state "Order\n7 states" as order
state "Payment\n6 states" as payment
state "Refund\n6 states" as refund
state "Ticket\n3 states" as ticket
order --> payment : create order,\nauthorize
payment --> order : capture sets Paid,\ndecline sets Payment failed
order --> refund : request refund
refund --> order : succeeded sets Refunded
refund --> payment : submitted calls\nprovider refund
payment --> refund : charge.refunded
order --> ticket : Paid issues tickets
refund --> ticket : approved voids tickets
@enduml
