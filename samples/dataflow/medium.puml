@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
  LineColor #475569
  LineThickness 1.2
}
element { BackgroundColor #F1F5F9; LineColor #475569; RoundCorner 6 }
arrow   { LineColor #475569; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
document { title { FontSize 18; FontStyle bold; LineThickness 0 } }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
top to bottom direction

title Level 1 DFD: order lifecycle (app zone = cloud runtime)

rectangle "Public internet" as z_pub #white;line:94A3B8;line.dashed {
  rectangle "Merchant\n(web shop)" as client
  rectangle "Courier\n(mobile app)" as server
}
rectangle "App zone" as z_app #white;line:94A3B8;line.dashed {
  usecase "1\nOrder intake" as p1
  usecase "2\nCourier\nassignment" as p2
  usecase "3\nDelivery\nattempts" as p3
  usecase "4\nProof of\ndelivery" as p4
  usecase "5\nBilling" as p5
}
rectangle "Data zone" as z_data #white;line:94A3B8;line.dashed {
  database "Orders DB\n(Postgres)" as db
  database "Documents\n(object store)" as docs
  database "Audit log\n(append-only)" as audit
}
rectangle "Third party" as z_3p #white;line:94A3B8;line.dashed {
  rectangle "Customs filing" as customs
  rectangle "Payments\n(provider)" as pay
}

client -[#D55E00,bold]-> p1     : submit order (PII)
server <-[#D55E00,bold]- p2     : dispatch job (PII)
server -[#D55E00,bold]-> p3     : attempt + GPS (PII)
client <-- p5     : send invoice
p1     -[#D55E00,bold]-> db     : write order (PII)
p1     --> docs     : store labels
p3     -[#D55E00,bold]-> db     : append attempt (PII)
p3     -[#D55E00,bold]-> docs     : store photos (PII)
p4     -[#D55E00,bold]-> docs     : write proof (PII)
p4     -[#D55E00,bold]-> customs  : file customs (PII)
p5     --> pay    : charge merchant
z_app  ..> audit  : append every event

legend bottom right
  Dashed box = trust boundary
  <color:#D55E00><b>Orange bold</b></color> = flow carries PII
  Ellipse = process, cylinder = data store
  Dashed = written by every process
  Processes hand off via Orders DB
  (reads omitted for clarity)
endlegend
@enduml
