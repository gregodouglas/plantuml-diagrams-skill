@startuml
' ---- house style (print) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 160
skinparam wrapWidth 160
<style>
root {
  FontName Helvetica
  FontSize 12
  FontColor #1F2937
  LineColor #475569
  LineThickness 1
}
element { BackgroundColor #F1F5F9; LineColor #475569; RoundCorner 6 }
arrow   { LineColor #475569; FontSize 11; MaximumWidth 160 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 11; MaximumWidth 200 }
document { title { FontSize 15; FontStyle bold; LineThickness 0 } }
caption { FontSize 11; FontColor #64748B }
legend  { FontSize 11; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
top to bottom direction

title Level 0 context DFD: courier platform (detail: large-1 to large-5)

rectangle "Public internet" as z_pub #white;line:94A3B8;line.dashed {
  rectangle "Merchant\n(web shop)" as client
  rectangle "Courier\n(mobile app)" as server
}
rectangle "App zone" as z_app #white;line:94A3B8;line.dashed {
  usecase "0\nParcel platform\n(processes 1-5)" as sys
}
rectangle "Data zone" as z_data #white;line:94A3B8;line.dashed {
  database "Orders DB\n(Postgres)" as db
  database "Documents\n(object store)" as docs
  database "Audit log" as audit
}
rectangle "Third party" as z_3p #white;line:94A3B8;line.dashed {
  rectangle "Customs filing" as customs
  rectangle "Payments\n(provider)" as pay
  rectangle "Email / SMS" as msg
  rectangle "Geocoding API" as geo
}

client -[#D55E00,bold]-> sys : submit order (PII)
client <-- sys : status, invoice
server <-[#D55E00,bold]- sys : dispatch job (PII)
server -[#D55E00,bold]-> sys : attempts + GPS (PII)
sys -[#D55E00,bold]-> db : orders, attempts (PII)
sys -[#D55E00,bold]-> docs : labels, photos (PII)
sys ..> audit : every event
sys -[#D55E00,bold]-> customs : file customs (PII)
sys --> pay : charge
sys -[#D55E00,bold]-> msg : notify (PII)
sys -[#D55E00,bold]-> geo : geocode (PII)
customs -[hidden]-> msg
pay -[hidden]-> geo

legend bottom right
  Dashed box = trust boundary
  <color:#D55E00><b>Orange bold</b></color> = flow carries PII
  Ellipse = process, cylinder = data store
  Dashed arrow = append-only write
endlegend
@enduml
