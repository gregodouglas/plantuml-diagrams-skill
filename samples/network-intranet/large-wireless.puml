@startuml
' ---- house style (print) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 160
skinparam wrapWidth 160
<style>
root {
  FontName Helvetica
  FontSize 12
  FontColor #1F2937
  LineColor #475569
  LineThickness 1
}
element { BackgroundColor #F1F5F9; LineColor #475569; RoundCorner 6 }
arrow   { LineColor #475569; FontSize 11; MaximumWidth 160 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 11; MaximumWidth 200 }
document { title { FontSize 15; FontStyle bold; LineThickness 0 } }
caption { FontSize 11; FontColor #64748B }
legend  { FontSize 11; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
top to bottom direction

title Wireless detail

node "Bldg A APs x12" as apa
node "Bldg B APs x8" as apb
node "Wireless controller\nVLAN 99 .5" as wlc <<accent>>
rectangle "SSIDs" as ssids {
  node "CORP\nWPA3-Enterprise" as corp
  node "VOICE\nWPA3-PSK" as voice
  node "GUEST\ncaptive portal" as guest #FEF2F2
}
node "NPS / RADIUS\nVLAN 10" as nps
node "VLAN 20\nWorkstations" as v20 #EFF6FF
node "VLAN 30\nVoIP" as v30 #EFF6FF
node "VLAN 50\nGuest" as v50 #FEF2F2

apa   --> wlc   : CAPWAP 5246
apb   --> wlc   : CAPWAP 5246
wlc   --> ssids  : broadcasts
corp  --> nps   : RADIUS 1812
corp  --> v20   : bridged
voice --> v30   : bridged
guest --> v50   : bridged

legend right
  APs sit in VLAN 99 and trunk the SSID VLANs locally (FlexConnect-style local switching).
endlegend
@enduml
