@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
  LineColor #475569
  LineThickness 1.2
}
element { BackgroundColor #F1F5F9; LineColor #475569; RoundCorner 6 }
arrow   { LineColor #475569; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
document { title { FontSize 18; FontStyle bold; LineThickness 0 } }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

title Office LAN VLANs (small)

node "Firewall\ninter-VLAN routing" as fw <<accent>>
node "Core switch\nL2/L3" as core

rectangle "VLAN 10 Servers\n10.10.10.0/24" as v10 #F0FDF4 {
  node "DC / DNS\n.10" as dc
  node "File server\n.20" as file
}
rectangle "VLAN 20 Workstations\n10.10.20.0/24" as v20 #EFF6FF {
  node "Desktops\nDHCP" as ws
}
rectangle "VLAN 40 Printers\n10.10.40.0/24" as v40 #FFF7ED {
  node "MFP printers" as prn
}

fw   --> core : 802.1Q trunk
core --> v10
core --> v20
core --> v40
ws   --> dc   : Kerberos, DNS
ws   --> file : SMB 445
ws   --> prn  : IPP 631

legend right
  Gateway for each VLAN is the firewall (.1).
  Edges between VLANs = flows the firewall allows.
endlegend
@enduml
