@startuml
' ---- house style (print) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 160
skinparam wrapWidth 160
<style>
root {
  FontName Helvetica
  FontSize 12
  FontColor #1F2937
  LineColor #475569
  LineThickness 1
}
element { BackgroundColor #F1F5F9; LineColor #475569; RoundCorner 6 }
arrow   { LineColor #475569; FontSize 11; MaximumWidth 160 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 11; MaximumWidth 200 }
document { title { FontSize 15; FontStyle bold; LineThickness 0 } }
caption { FontSize 11; FontColor #64748B }
legend  { FontSize 11; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
top to bottom direction

title Campus switch fabric detail

node "Firewall HA pair\n(see VLAN rules)" as fw <<muted>>
rectangle "Core stack  10.10.99.2" as cs #EFF6FF {
  node "CORE-1" as c1 <<accent>>
  node "CORE-2" as c2
}
rectangle "Building A" as ba {
  rectangle "Dist A pair (MLAG)" as dap {
    node "DIST-A1" as da1
    node "DIST-A2" as da2
  }
  node "ACC-A1" as aa1
  node "ACC-A2" as aa2
  node "ACC-A3" as aa3
  node "ACC-A4" as aa4
}
rectangle "Building B" as bb {
  rectangle "Dist B pair (MLAG)" as dbp {
    node "DIST-B1" as db1
    node "DIST-B2" as db2
  }
  node "ACC-B1" as ab1
  node "ACC-B2" as ab2
  node "ACC-B3" as ab3
}

fw  --> cs  : LACP 2x10G
c1   -  c2
da1  -  da2
db1  -  db2
cs  --> dap : MLAG 2x10G
cs  --> dbp : MLAG 2x10G
dap --> aa1
dap --> aa2
dap --> aa3
dap --> aa4
dbp --> ab1
dbp --> ab2
dbp --> ab3

legend right
  Every access switch is dual-homed to its distribution pair (2x10G LACP).
  Trunks to access: VLAN 20, 30, 40, 50, 99. Switch mgmt IPs in VLAN 99.
endlegend
@enduml
