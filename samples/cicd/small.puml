@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
  LineColor #475569
  LineThickness 1.2
}
element { BackgroundColor #F1F5F9; LineColor #475569; RoundCorner 6 }
arrow   { LineColor #475569; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
document { title { FontSize 18; FontStyle bold; LineThickness 0 } }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
activityDiagram {
  activityBar { BackgroundColor #475569; LineColor #475569 }
  activity { MaximumWidth 200 }
  diamond  { FontSize 12 }
  arrow    { FontSize 12 }
}
</style>
hide stereotype

title PR pipeline (on pull_request): checks to preview
skinparam conditionStyle diamond

|GitHub Actions|
start
fork
  :Lint;
fork again
  :Typecheck;
fork again
  :Unit tests;
fork again
  :Playwright e2e;
end fork
if (All checks green?) then (no)
  :Mark PR failing;
  stop
else (yes)
  :Build app image;
  |Platform|
  :Deploy preview; <<accent>>
  |GitHub Actions|
  :Comment preview URL;
  stop
endif
@enduml
