@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 40 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide stereotype

' ---- body ----
title Payment webhook: idempotent intake
hide footbox
autonumber "<b>00"

participant "Payment\nprovider" as pay
participant "Ticketing API"     as api
database    "Database"          as db
queue       "Job queue"         as q
participant "Worker"            as w

pay -> api : POST /webhooks/payments
alt bad signature
  api --> pay : 400, nothing stored
else event id exists
  api -> db : insert webhook_events
  db --> api : duplicate event id
  api --> pay : 200, stop
else new event
  api -> db : insert webhook_events
  api -> q : enqueue job
  api --> pay : 200
end
q -> w : process_webhook job
note over w : by type: authorized, failed,\nrefunded, dispute
@enduml
