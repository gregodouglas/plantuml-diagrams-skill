@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 62 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide stereotype

' ---- body ----
title Checkout: seat hold and payment outcomes
hide footbox
autonumber "<b>00"

participant "Fan web app"      as web
participant "Ticketing API"    as api
participant "Seat-hold\ncache"  as cache
participant "Payment\nprovider" as pay

web -> api : POST /events/{id}/holds
api -> cache : SET NX each seat (10 min TTL)
alt seat held
  api -> cache : release seats taken
  api --> web : 409 seats_taken
else all free
  api --> web : hold id + expiry
end
web -> api : POST /orders (hold id)
api -> pay : authorize
alt authorized
  api -> pay : capture
  api --> web : 201 order
else 3-D Secure
  api --> web : 202 challenge URL
else declined
  api --> web : 402
end
@enduml
