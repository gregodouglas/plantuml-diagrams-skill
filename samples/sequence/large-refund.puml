@startuml
' ---- house style (print) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 160
skinparam wrapWidth 160
<style>
root {
  FontName Helvetica
  FontSize 12
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1; FontSize 11; MaximumWidth 160 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 11; MaximumWidth 200 }
title   { FontSize 15; FontStyle bold }
caption { FontSize 11; FontColor #64748B }
legend  { FontSize 11; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 11 }
}
</style>
hide stereotype

' ---- body ----
title Refund: request to confirmation
hide footbox
autonumber "<b>00"

participant "Fan\nweb app"      as web
participant "Ticketing\nAPI"    as api
participant "Payment\nprovider" as pay
queue       "Job\nqueue"        as q
participant "Worker"            as w
participant "Email\nservice"    as mail

web -> api : POST /orders/{id}/refunds
note over api : check venue policy:\nallowed until 48 h before event
alt outside window
  api --> web : stored as pending_review
  note over api : venue staff review,\nthen approve
else approved
  note over api : void tickets
  api -> pay : refund
  note over api : refund = submitted
  pay -> api : webhook charge.refunded
  api -> q : enqueue job
  q -> w : process_webhook
  note over w : refund = succeeded\norder = refunded
  w -> mail : send refund notice
end
@enduml
