@startuml
' ---- house style (print) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 160
skinparam wrapWidth 160
' NOTE: title style moved under document { } - a top-level title { LineThickness 0 } strips node borders in SVG/PDF (see NOTES.md)
<style>
root {
  FontName Helvetica
  FontSize 12
  FontColor #1F2937
  LineColor #475569
  LineThickness 1
}
element { BackgroundColor #F1F5F9; LineColor #475569; RoundCorner 6 }
arrow   { LineColor #475569; FontSize 11; MaximumWidth 160 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 11; MaximumWidth 200 }
document { title { FontSize 15; FontStyle bold; LineThickness 0 } }
caption { FontSize 11; FontColor #64748B }
legend  { FontSize 11; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

title DR replication - HQ to DR site

' Takeaway: three independent copies leave HQ over the WAN: Veeam VM replicas
' (RPO 15 min), array LUN replication, and immutable backup copies.

package "HQ site" as hq {
  node "Veeam B&R" as vbr <<accent>>
  database "Array HQ" as arr1
  node "Veeam repo HQ\n(nightly, 14 days)" as repo1
}
cloud "WAN 1 Gbps\nIPsec over MPLS" as wan
package "DR site" as dr {
  package "Cluster DR (2 hosts)" as drc {
    node "esx-dr1" as h1
    node "esx-dr2" as h2
    [Replica VMs\n(powered off)] as rep
  }
  database "Array DR" as arr2
  node "Veeam repo DR\n(hardened, 30 d immutable)" as repo2
}

vbr   -> repo1
repo1 --> wan   : backup copy
vbr   --> wan   : VM replication
arr1  --> wan   : LUN snapshots
wan   --> rep   : replicas, RPO 15 min
wan   --> arr2  : LUN replicas
wan   --> repo2 : immutable copies
@enduml
