@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
' NOTE: title style moved under document { } - a top-level title { LineThickness 0 } strips node borders in SVG/PDF (see NOTES.md)
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
  LineColor #475569
  LineThickness 1.2
}
element { BackgroundColor #F1F5F9; LineColor #475569; RoundCorner 6 }
arrow   { LineColor #475569; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
document { title { FontSize 18; FontStyle bold; LineThickness 0 } }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

title vSphere topology - small site

' Takeaway: two ESXi hosts managed by vCenter reach one array over
' redundant iSCSI paths A/B, and Veeam backs it up off-host.

node "vCenter Server" as vc
node "ESXi cluster\n(2 hosts, HA)" as esx {
  [VMs: DC, SQL,\nFile, App] as vms
  [vSwitch0\nmgmt · vMotion\nVM · iSCSI] as vss
}
node "ToR switches A / B\n(iSCSI VLANs)" as tor
node "Storage array" as arr {
  database "Datastore\nLUN 1" as ds
}
node "Veeam B&R\n(vSphere API)" as veeam <<accent>>

vc    --> esx  : manages
vms   -> vss
vss   --> tor  : 2x 10G uplinks
tor   -> ds
veeam -> vc
veeam --> ds   : reads via SAN
@enduml
