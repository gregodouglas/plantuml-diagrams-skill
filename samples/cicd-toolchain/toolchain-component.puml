@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

' ---- body ----
' ---- body ----
title Self-hosted CI/CD toolchain

' Stages as columns, left to right. Under "left to right direction" a column is built with
' b -[hidden]right- a (same rank, written bottom-to-top); a -[hidden]- b would make a ROW.

actor "Developers" as dev
rectangle "SSO\n(OIDC)" as sso <<accent>>
rectangle "Vault\n(secrets)" as vault <<alert>>

package "Forgejo" as forge {
  [Repos & PRs] as scm
  [Workflows] as ci
  [Registry] as reg
}
package "Build network" as build {
  [Actions runners] as runner
  [Legacy build server] as legacy <<muted>>
}
package "Gates" as gates {
  [Semgrep SAST] as semgrep
  [SonarQube] as sonar
  [Grype (image)] as grype
}
package "Delivery" as deliv {
  [Terraform (IaC)] as tf
  [Ansible] as ansible
}
node "Kubernetes cluster" as k8s

' columns
reg -[hidden]right- ci
ci -[hidden]right- scm
legacy -[hidden]right- runner
grype -[hidden]right- sonar
sonar -[hidden]right- semgrep
ansible -[hidden]right- tf
vault -[hidden]right- sso
sso -[hidden]right- dev

dev --> scm : push / PR
scm -> ci
ci --> runner : jobs
vault --> build : secrets
runner --> semgrep : scan
runner --> sonar : scan
runner --> grype : scan
reg <-- runner : push image
runner --> tf : plan / apply
runner --> ansible : playbooks
tf --> k8s : provisions
ansible --> k8s : deploys

legend bottom right
  SSO signs everyone in (Forgejo, SonarQube, the Kubernetes API); the cluster pulls images from the registry.
  Grey = legacy / optional (build server, being retired).
endlegend
@enduml
