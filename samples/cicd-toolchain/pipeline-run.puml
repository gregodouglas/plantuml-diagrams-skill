@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
activityDiagram {
  activity    { MaximumWidth 200 }
  diamond     { FontSize 12 }
  arrow       { FontSize 12 }
  activityBar { BackgroundColor #475569; LineColor #475569 }
}
</style>
hide stereotype

' ---- body ----
title One pipeline run
' Gates: happy path stays in the then-branch, the failure exit is the else (keeps the diagram compact).

|Developer|
start
:Push branch /\nopen pull request;
|Forgejo|
:Workflow triggered\nfrom repo;
|Actions runner|
:Fetch secrets\nfrom Vault;
fork
  :Build & unit test;
fork again
  :Semgrep SAST;
fork again
  :SonarQube analysis;
end fork
if (All gates passed?) then (yes)
  :Build container image;
  :Grype image scan;
  if (No critical CVEs?) then (yes)
    :Push image to\nForgejo registry;
    |Forgejo|
    :Pull request\napproved & merged;
    |Actions runner|
    :Terraform plan / apply\n(cluster infra);
    :Ansible playbooks\n(configure nodes, deploy);
    :Deploy to Kubernetes,\nrun health checks;
    stop
  else (no)
    :Fail job,\nreport CVEs on PR;
    stop
  endif
else (no)
  :Fail job,\nreport findings on PR;
  stop
endif
@enduml
