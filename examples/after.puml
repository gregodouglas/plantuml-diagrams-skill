@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
top to bottom direction

' ---- body ----
title Order platform: request and event flow

actor "Customer" as cust
package "Edge" {
  [Load Balancer] as lb
  [API Gateway]   as gw
}
package "Services" {
  [User Profile Service] as users
  [Order Service]        as orders
  [Inventory Service]    as inv
  [Payment Service]      as pay
  [Notification Service] as notif
}
package "Data" {
  database "Orders DB"      as odb
  queue    "Event Bus"      as bus
  database "Inventory DB"   as idb
  storage  "Object Storage" as s3
}

cust   --> lb     : HTTPS
lb     ->  gw
gw     --> users  : profile
gw     --> orders : orders
gw     --> inv    : stock check
orders ->  pay    : authorize
orders -[norank]-> odb : persist
orders --> bus    : OrderCreated
inv    --> idb    : reserve
inv    --> bus    : StockChanged
pay    --> bus    : PaymentSettled
bus    --> notif  : events
notif  --> s3     : templates
users  -[norank]-> odb : history
@enduml
